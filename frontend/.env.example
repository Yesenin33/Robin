# Base path of the API (proxied by vite in dev / nginx in prod)
VITE_API_URL=/api
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_RPC_URL=https://rpc.chain.robinhood.com
# Buy/Sell deep link (external swap UI, the user signs in their own wallet). Placeholders:
# {ca} token, {side} buy|sell, {in}/{out} input/output currency (ETH <-> token).
# Example (verify the chain slug for Robinhood Chain in the swap UI before shipping):
# VITE_SWAP_URL=https://app.uniswap.org/swap?chain=robinhood&inputCurrency={in}&outputCurrency={out}
VITE_SWAP_URL=
VITE_SWAP_NATIVE=ETH
