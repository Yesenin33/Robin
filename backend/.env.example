ENV=prod
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://api.chainfolio.app
FRONTEND_URL=https://chainfolio.app
CORS_ORIGINS=["https://chainfolio.app"]

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://chainfolio:change-me@postgres:5432/chainfolio
REDIS_URL=redis://redis:6379/0

CHAIN_ID=4663
# Official public node: answers eth_getLogs (mirrors cap the range / need an archive token)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
NATIVE_SYMBOL=ETH

CHAIN_NAME=robinhood
# Blockscout-compatible explorer API (exact holder count + top holders)
EXPLORER_API_URL=https://robinhoodchain.blockscout.com
# The explorer sits behind a Cloudflare challenge; reads are routed through this read proxy.
# Set empty to call the explorer directly (only works if it is not challenged).
EXPLORER_PROXY_PREFIX=https://r.jina.ai
DEXSCREENER_CHAIN=robinhood
GECKOTERMINAL_NETWORK=robinhood
HOLDER_SCAN_BLOCKS=60000
LOG_CHUNK_BLOCKS=9999

# intelligence (default, in-repo) | builtin (market-only, offline dev)
SCAN_ENGINE=intelligence
SCAN_TIMEOUT_S=60

JWT_SECRET=generate-with-openssl-rand-hex-32
SIWE_DOMAIN=chainfolio.app

# empty SMTP_HOST = magic links are logged instead of e-mailed (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chainfolio <no-reply@chainfolio.app>

RATE_LIMIT_PER_MIN=60
SAFETY_CACHE_TTL_S=600
SAFETY_REFRESH_MIN=30
SAFETY_STALE_MIN=60
POSITION_SNAPSHOT_MIN=5

# --- production data sources ---
# Fallback RPCs tried in order when RPC_URL fails.
# IMPORTANT (measured): Alchemy's FREE tier caps eth_getLogs at a 10-block range, and the client
# promotes whichever endpoint answered last — so putting Alchemy here makes it primary and then
# kills every eth_getLogs call. Keep RPC_URL on the official node and list only nodes that serve
# wide log ranges (drpc caps at 10k blocks — that is why LOG_CHUNK_BLOCKS=9999).
RPC_FALLBACK_URLS=https://robinhood.drpc.org
# Bearer key for the explorer read proxy (r.jina.ai API key) — higher limits than anonymous
EXPLORER_PROXY_KEY=
RATE_LIMIT_USER_PER_MIN=120
WARMUP_TOKENS=20

# --- indexer / copy feed ---
# Set if Robinhood Chain pools pair against WETH instead of native ETH
# WETH on Robinhood Chain (measured: 0x0bd7d308f8e1639fab988df18a8011f41eacad73)
# NOTE: pools here do NOT quote in native ETH. Measured across sampled swaps: USDG
# (0x5fc5360d0400a0fd4f2af552add042d716f1d168, "Global Dollar", ~$1) is the most common
# counter-currency, then WETH, then tokenized equities (e.g. SPCX "… • Robinhood Token").
# Anything that values a trade in ETH will score 0 wallets — rank in USD, treating USDG as $1.
WETH_ADDRESS=0x0bd7d308f8e1639fab988df18a8011f41eacad73
# First-run discovery window. 2,000,000 blocks hammers the public node; 60,000 is a sane default
# (measured: 593 pools -> 510 new tokens in 132 s).
DISCOVERY_LOOKBACK_BLOCKS=60000
COPY_LOOKBACK_BLOCKS=20000
BACKFILL_BLOCKS=1000000
BACKFILL_PAGES=4
RANK_TOKENS=15
RANK_SWAPS_PER_TOKEN=300
RANK_WINDOW_BLOCKS=500000
SUGGESTED_MIN_CLOSED=2

# --- alerts ---
ALERTS_PER_HOUR=10
PRICE_MOVE_PCT=20
# Copy the value from the box's secret store; never commit it
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# python -m scripts.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chainfolio.app
