ENV=prod
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://api.chainfolio.app
FRONTEND_URL=https://chainfolio.app
CORS_ORIGINS=["https://chainfolio.app"]

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://chainfolio:change-me@postgres:5432/chainfolio
REDIS_URL=redis://redis:6379/0

CHAIN_ID=4663
# Official public node: answers eth_getLogs (mirrors cap the range / need an archive token)
RPC_URL=https://rpc.mainnet.chain.robinhood.com
NATIVE_SYMBOL=ETH

CHAIN_NAME=robinhood
# Blockscout-compatible explorer API (exact holder count + top holders)
EXPLORER_API_URL=https://robinhoodchain.blockscout.com
# The explorer sits behind a Cloudflare JS challenge that only a real browser passes (plain HTTP gets 403,
# cf-mitigated: challenge). Explorer reads go through the Chromium sidecar (service `browser`, ../browser):
# POST {EXPLORER_BROWSER_URL}/internal/fetch. Only the explorer uses it: DexScreener / GeckoTerminal are fetched
# directly. docker-compose sets this URL for api + worker by default; set it to an empty value to disable.
EXPLORER_BROWSER_URL=http://browser:8765
# Optional shared secret between the engine and the sidecar (it is internal-only anyway)
EXPLORER_BROWSER_TOKEN=
# Optional FALLBACK read proxy, used only when the browser failed. EMPTY = no proxy at all (nothing paid, and no
# source error can ever mention a proxy). Example: https://r.jina.ai (+ EXPLORER_PROXY_KEY below).
EXPLORER_PROXY_PREFIX=
DEXSCREENER_CHAIN=robinhood
GECKOTERMINAL_NETWORK=robinhood
HOLDER_SCAN_BLOCKS=60000
LOG_CHUNK_BLOCKS=9999

# intelligence (default, in-repo) | builtin (market-only, offline dev)
SCAN_ENGINE=intelligence
SCAN_TIMEOUT_S=60

JWT_SECRET=generate-with-openssl-rand-hex-32
SIWE_DOMAIN=chainfolio.app

# empty SMTP_HOST = magic links are logged instead of e-mailed (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chainfolio <no-reply@chainfolio.app>

RATE_LIMIT_PER_MIN=60
SAFETY_CACHE_TTL_S=600
SAFETY_REFRESH_MIN=30
SAFETY_STALE_MIN=60
POSITION_SNAPSHOT_MIN=5

# --- production data sources ---
# RPC endpoints. RPC_URL is tried first, then RPC_FALLBACK_URLS, in order. An endpoint that answers 429 is left
# alone for Retry-After (or 2 s, 4 s, 8 s ... +-25 %, max 60 s); one that fails twice in a row (HTTP 5xx,
# network, JSON-RPC "internal error") is benched for 15 s, 30 s, 60 s ... up to 5 min. A 5xx never ends the
# chain: the next endpoint is tried. An endpoint moves to the front only after a clean answer.
# Do NOT list nodes that never answer here: robinhood.drpc.org returns HTTP 500 on eth_getLogs (37 of 37
# calls measured) and only adds latency. Alchemy's FREE tier caps eth_getLogs at 10 blocks; it is never sent a
# wider range (intelligence/endpoints.py LOG_RANGE_CAPS), so a keyed Alchemy URL is safe for ordinary calls.
RPC_FALLBACK_URLS=https://robinhood-rpc.publicnode.com
# Endpoints tried FIRST for eth_getLogs bursts, before the list above. The official node throttles log bursts
# (HTTP 429) first; publicnode answered 200 at the same moments. Empty = same order as above.
RPC_LOGS_URLS=
# eth_getLogs in flight across the whole worker process (scans + indexer + copy + ranking), and the minimum
# spacing between them. Lower = fewer 429s, slower scans.
RPC_LOGS_CONCURRENCY=2
RPC_LOGS_MIN_INTERVAL_MS=100
# JSON-RPC calls per HTTP request for portfolio/position snapshots (800+ tokens used to go in ONE request)
RPC_BATCH_SIZE=50
# A scan that fails (or comes back without holders) is retried with backoff, then left alone for a while, so a
# failing token can't be re-queued every few minutes by warmup / refresh_stale / discovery.
SCAN_RETRY_MAX=3
SCAN_RETRY_DELAYS=30,120,480
SCAN_GIVE_UP_COOLDOWN_S=3600
# Bearer key for the explorer read proxy (r.jina.ai API key) — higher limits than anonymous
EXPLORER_PROXY_KEY=
RATE_LIMIT_USER_PER_MIN=120

# --- scan queues ---
# user-requested refreshes go to a separate priority queue; bulk (discovery, warmup, stale) is capped
SCAN_QUEUE_MAX=300
SCAN_CONCURRENCY=4
SCAN_BULK_PER_TICK=8
REFRESH_BATCH=40
# explorer reads per minute across all threads; 0 = auto (60 via the browser, 20 anonymous proxy, 200 with key)
EXPLORER_RPM=0
WARMUP_TOKENS=20

# --- indexer / copy feed ---
# Set if Robinhood Chain pools pair against WETH instead of native ETH
# WETH on Robinhood Chain (measured: 0x0bd7d308f8e1639fab988df18a8011f41eacad73)
# NOTE: pools here do NOT quote in native ETH. Measured across sampled swaps: USDG
# (0x5fc5360d0400a0fd4f2af552add042d716f1d168, "Global Dollar", ~$1) is the most common
# counter-currency, then WETH, then tokenized equities (e.g. SPCX "… • Robinhood Token").
# Anything that values a trade in ETH will score 0 wallets — rank in USD, treating USDG as $1.
WETH_ADDRESS=0x0bd7d308f8e1639fab988df18a8011f41eacad73
# Quote currencies for USD valuation: address=USD ($1 peg) or address=ETH (ETH price). Native ETH and
# WETH_ADDRESS are always ETH. Trades quoted in anything else (e.g. tokenized equities) are not ranked.
QUOTE_TOKENS=0x5fc5360d0400a0fd4f2af552add042d716f1d168=USD,0x0bd7d308f8e1639fab988df18a8011f41eacad73=ETH
# First-run discovery window. 2,000,000 blocks hammers the public node; 60,000 is a sane default
# (measured: 593 pools -> 510 new tokens in 132 s).
DISCOVERY_LOOKBACK_BLOCKS=60000
COPY_LOOKBACK_BLOCKS=20000
BACKFILL_BLOCKS=1000000
BACKFILL_PAGES=4
RANK_TOKENS=40
RANK_SWAPS_PER_TOKEN=800
RANK_WINDOW_BLOCKS=600000
SUGGESTED_MIN_CLOSED=2
# below this many strong wallets, top up with single-trade winners; spectate = top wallets collected for everyone
SUGGESTED_FILL_TO=20
SPECTATE_WALLETS=10

# --- alerts ---
ALERTS_PER_HOUR=10
PRICE_MOVE_PCT=20
# Copy the value from the box's secret store; never commit it
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=chainfolio_bot
# Webhook path + header secret (32+ chars, [A-Za-z0-9_-]): python -c "import secrets;print(secrets.token_urlsafe(32))"
# then: docker compose exec api python -m scripts.telegram_setup
TELEGRAM_WEBHOOK_SECRET=
# python -m scripts.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@chainfolio.app
