ENV=prod
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://api.chainfolio.app
FRONTEND_URL=https://chainfolio.app
CORS_ORIGINS=["https://chainfolio.app"]

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://chainfolio:change-me@postgres:5432/chainfolio
REDIS_URL=redis://redis:6379/0

CHAIN_ID=4663
RPC_URL=https://rpc.chain.robinhood.com
NATIVE_SYMBOL=ETH

# CRAWLSCAN: host dir mounted to /opt/crawlscan; entry = module:function(address) -> dict
CRAWLSCAN_HOST_PATH=/root/crawlscan
CRAWLSCAN_PATH=/opt/crawlscan
CRAWLSCAN_ENTRY=crawlscan:scan
SCAN_TIMEOUT_S=60

JWT_SECRET=generate-with-openssl-rand-hex-32
SIWE_DOMAIN=chainfolio.app

# empty SMTP_HOST = magic links are logged instead of e-mailed (dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Chainfolio <no-reply@chainfolio.app>

RATE_LIMIT_PER_MIN=60
SAFETY_CACHE_TTL_S=600
SAFETY_REFRESH_MIN=30
SAFETY_STALE_MIN=60
POSITION_SNAPSHOT_MIN=5
